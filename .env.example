# =============================================================================
# Wave Ops Hub — Environment Variables Template
# =============================================================================
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite .env.local — está no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Obter no Dashboard Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key — APENAS para Server Actions privilegiadas
# NUNCA expor ao cliente. Sem prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# JWT secret — usado para verificar JWT customizado
SUPABASE_JWT_SECRET=...

# -----------------------------------------------------------------------------
# Database (Drizzle)
# -----------------------------------------------------------------------------
# Connection string completa do Postgres do Supabase
# Em Settings > Database > Connection string > URI

DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-...pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-...pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Wave Ops Hub
NEXT_PUBLIC_APP_URL=https://wave.tallpa.com.br
NEXT_PUBLIC_BASE_DOMAIN=tallpa.com.br

# Modo (development | staging | production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

NEXT_PUBLIC_STORAGE_BUCKET_UPLOADS=uploads

# -----------------------------------------------------------------------------
# Observabilidade (opcional, futuro)
# -----------------------------------------------------------------------------

# SENTRY_DSN=
# VERCEL_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# Outros
# -----------------------------------------------------------------------------

# Limite de tamanho de arquivo (MB) para upload de planilhas
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=10
