# =============================================================================
# Wave Ops Hub — Environment Variables Template
# =============================================================================
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite .env.local — está no .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Obter no Dashboard Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key — APENAS para Server Actions privilegiadas
# NUNCA expor ao cliente. Sem prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# JWT secret — usado para verificar JWT customizado
SUPABASE_JWT_SECRET=...

# -----------------------------------------------------------------------------
# Database (Drizzle)
# -----------------------------------------------------------------------------
# Connection string completa do Postgres do Supabase
# Em Settings > Database > Connection string > URI

DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-...pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-...pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Wave Ops Hub
NEXT_PUBLIC_APP_URL=https://wave.tallpa.com.br
NEXT_PUBLIC_BASE_DOMAIN=tallpa.com.br

# Domínio raiz usado pelo middleware para resolver subdomínios.
# Em dev: localhost | Em prod: tallpa.com.br
# Sem protocolo, sem porta, sem trailing slash.
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Modo (development | staging | production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

NEXT_PUBLIC_STORAGE_BUCKET_UPLOADS=uploads

# -----------------------------------------------------------------------------
# IQI — coleta do indicador da Unetvale (ADR-012)
# -----------------------------------------------------------------------------
# Credencial de serviço da Unetvale usada pelo coletor. APENAS servidor —
# NUNCA prefixar com NEXT_PUBLIC_ nem expor ao cliente.
UNETVALE_USER=
UNETVALE_PASSWORD=

# Segredo do cron de coleta. O workflow .github/workflows/iqi-cron.yml envia
# `Authorization: Bearer <CRON_SECRET>` ao chamar /api/cron/iqi, que valida o header.
# Mesmo valor precisa existir em GitHub Secrets (repo) e nas envs do servidor (Vercel).
# Gerar um valor aleatório forte (ex.: `openssl rand -hex 32`).
CRON_SECRET=

# -----------------------------------------------------------------------------
# Observabilidade (opcional, futuro)
# -----------------------------------------------------------------------------

# SENTRY_DSN=
# VERCEL_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# Testes E2E (Playwright)
# -----------------------------------------------------------------------------
# Contas de teste reais no Supabase dev — nunca usar credenciais de produção.
# Criar as contas via Supabase Dashboard > Authentication > Users
# e vincular na tabela public.users com o role correto.

PLAYWRIGHT_ADMIN_EMAIL=
PLAYWRIGHT_ADMIN_PASSWORD=

PLAYWRIGHT_MANAGER_EMAIL=
PLAYWRIGHT_MANAGER_PASSWORD=

PLAYWRIGHT_TECHNICIAN_EMAIL=
PLAYWRIGHT_TECHNICIAN_PASSWORD=

# -----------------------------------------------------------------------------
# Outros
# -----------------------------------------------------------------------------

# Limite de tamanho de arquivo (MB) para upload de planilhas
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=10
